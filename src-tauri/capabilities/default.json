{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only what the HD Fantasma window uses: its own commands, progress events and the open/save dialogs (audit 2026-11-14).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-list-disks",
    "allow-list-mounted-volumes",
    "allow-read-disk",
    "allow-cancel-read",
    "allow-list-children",
    "allow-get-item",
    "allow-search",
    "allow-find-duplicates",
    "allow-rename-disk",
    "allow-delete-disk",
    "allow-export-disk",
    "allow-import-disk",
    "allow-reveal-item",
    "allow-get-settings",
    "allow-set-settings",
    "allow-claude-status",
    "allow-claude-connect",
    "allow-claude-disconnect"
  ]
}
